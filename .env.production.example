# ── Security Guardian Platform — PRODUCTION environment CONTRACT (template) ──────────────────────
#
# Copy to `.env.production` (git-ignored) and fill REAL values. NEVER commit `.env.production`.
# This template contains NO secrets — every value here is a placeholder or a generator command.
#
# Deployment interpolates this file into the per-plane service `environment:` blocks in
# docker-compose.prod.yml. The plane split (which key reaches which service) is enforced THERE,
# not here — see docs/deployment/01-secrets-and-environment.md and 04-network-topology.md.
#
# The platform FAILS FAST at startup (guardian_common.config._enforce_production_invariants) if any
# of the invariants below are violated, so a misconfiguration cannot boot silently weakened.
#
# Generate every key/password with a strong CSPRNG, e.g.:
#     openssl rand -hex 32          # 256-bit hex — JWT / encryption / broker-seal / passwords
#     openssl rand -base64 24       # if you prefer base64 for passwords
# Ed25519 job-signing keypair (raw 32 bytes, base64) — see docs/deployment/01 for the snippet.

# ── Core ─────────────────────────────────────────────────────────────────────────────────────────
# MUST be `production` (or `staging`) so the fail-fast invariants engage. Anything in
# {local,dev,development,test,ci} is treated as non-production and SKIPS the invariants.
GUARDIAN_ENV=production
GUARDIAN_LOG_LEVEL=INFO

# ── Auth / JWT (CONTROL PLANE ONLY: api, worker-default) ─────────────────────────────────────────
# Strong + unique. Refused if left at the dev sentinel outside local/dev.
# NEVER set on the execution planes (worker-recon, worker-tools) — they never sign/verify tokens.
GUARDIAN_JWT_SECRET=CHANGE_ME__openssl_rand_hex_32
GUARDIAN_JWT_ALGORITHM=HS256
GUARDIAN_ACCESS_TOKEN_TTL_MINUTES=60

# ── Cryptographic keys ───────────────────────────────────────────────────────────────────────────
# ENCRYPTION_KEY = credential KMS master (decrypts stored tenant secrets). CONTROL PLANE ONLY.
#   Refused (must differ from the dev sentinel) on control planes; FORBIDDEN on execution planes.
GUARDIAN_ENCRYPTION_KEY=CHANGE_ME__openssl_rand_hex_32__DISTINCT_FROM_ALL_OTHERS
# BROKER_SEAL_KEY = payload-seal key for job/result envelopes on Redis (P1-4). Held by the control
#   plane AND worker-tools; NEVER by worker-recon. MUST differ cryptographically from ENCRYPTION_KEY.
GUARDIAN_BROKER_SEAL_KEY=CHANGE_ME__openssl_rand_hex_32__DISTINCT_FROM_ENCRYPTION_KEY

# ── Job signing (Ed25519, base64 raw 32 bytes) ───────────────────────────────────────────────────
# The trusted dispatcher (control plane) holds ONLY the private key; worker-tools holds ONLY the
# public key and can never mint a job. NEVER set the PRIVATE key on worker-tools (startup refuses it).
GUARDIAN_JOB_SIGNING_PRIVATE_KEY=CHANGE_ME__ed25519_private_base64   # control plane only
GUARDIAN_JOB_SIGNING_PUBLIC_KEY=CHANGE_ME__ed25519_public_base64     # control plane AND worker-tools

# ── Database (PostgreSQL) ────────────────────────────────────────────────────────────────────────
# Owner DSN runs migrations + is used by worker-default (cross-tenant engines legitimately bypass RLS).
# App DSN is the non-owner, RLS-enforced `guardian_app` role used by the API request path.
# BOTH must enforce TLS: sslmode in {require, verify-ca, verify-full}. verify-full is recommended.
# The `guardian_app` role is created LOGIN with NO password by migration 0005 — you MUST set its
# password in the managed DB (see docs/deployment/02-database.md) before these DSNs will authenticate.
GUARDIAN_DATABASE_URL=postgresql+psycopg://guardian:CHANGE_ME_DB_PW@db.internal:5432/guardian?sslmode=verify-full
GUARDIAN_APP_DATABASE_URL=postgresql+psycopg://guardian_app:CHANGE_ME_APP_PW@db.internal:5432/guardian?sslmode=verify-full
# Note: worker-default is NOT an execution plane, so it ALSO requires APP_DATABASE_URL set and
# distinct from DATABASE_URL (even though it connects with the owner DSN). The execution planes
# (worker-recon, worker-tools) set GUARDIAN_DATABASE_URL="" and are DB-incapable.

# Optional pool tuning (front with PgBouncer for real scale).
# GUARDIAN_DB_POOL_SIZE=5
# GUARDIAN_DB_MAX_OVERFLOW=10
# GUARDIAN_DB_POOL_TIMEOUT=30

# ── Redis (broker + result backend + replay-nonce store) ─────────────────────────────────────────
# Outside local/dev the URL MUST use TLS (rediss://) AND carry AUTH credentials. All planes share it.
# Password-only (rediss://:PW@host) or ACL user (rediss://user:PW@host) both satisfy AUTH.
GUARDIAN_REDIS_PASSWORD=CHANGE_ME__strong_redis_password
GUARDIAN_REDIS_URL=rediss://:CHANGE_ME__strong_redis_password@redis.internal:6379/0

# ── Ingress / proxy ──────────────────────────────────────────────────────────────────────────────
# Number of TRUSTED reverse-proxy hops that append X-Forwarded-For in front of the API. With the
# reference nginx ingress that is exactly 1. Must match the real topology or client IP (audit +
# login rate-limit) will be wrong. 0 = ignore XFF and use the socket peer.
GUARDIAN_TRUSTED_PROXY_COUNT=1
# Comma-separated production dashboard origin(s). No wildcard when credentials are used.
GUARDIAN_CORS_ORIGINS=https://app.example.com

# ── Bootstrap admin (created by the seed job) ────────────────────────────────────────────────────
# Checked UNCONDITIONALLY on every plane at startup: MUST be changed from the default or NO service
# boots outside local/dev. Set the same value on every plane's env.
GUARDIAN_BOOTSTRAP_TENANT=Your Org
GUARDIAN_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
GUARDIAN_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME__strong_unique_password

# ── Platform governance (optional) ───────────────────────────────────────────────────────────────
# Comma-separated user ids with platform-level authority. Empty is fine.
# GUARDIAN_PLATFORM_OWNER_IDS=

# ── DevSecOps: GitHub webhook (optional) ─────────────────────────────────────────────────────────
# Empty = the webhook endpoint rejects all deliveries. Set to enable push-triggered scans.
# GUARDIAN_GITHUB_WEBHOOK_SECRET=CHANGE_ME__webhook_hmac_secret

# ── AI analyst (optional) ────────────────────────────────────────────────────────────────────────
# Empty = deterministic stub provider (no external calls). Set to enable the real provider.
# GUARDIAN_ANTHROPIC_API_KEY=
# GUARDIAN_AI_MODEL=claude-opus-5

# ── FROZEN preconditions (do NOT change without lifting the platform Freeze) ──────────────────────
# * Do NOT install semgrep (SAST env-leak P2 is dormant only while semgrep is absent).
# * Do NOT wire tool-execution to the API (evidence-chain concurrent-append P2 is dormant only while
#   dispatch_tool_job / dispatch_artifact_job are enqueued by no API route).
