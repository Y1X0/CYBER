# Scanner runtime — the artifact plane (WP-A2).
#
# Guardian's execution model splits scanning in two, and only one half needs kernel privileges:
#
#   * ARTIFACT PLANE (this image) — analyses things the customer gives us: repositories, images,
#     manifests, lockfiles, cloud config. It never sends a packet to a customer system, so it runs
#     under the in-process sandbox and needs no CAP_NET_ADMIN. This is the entire code-security
#     product, and it deploys anywhere a container runs.
#
#   * NETWORK PLANE (separate image) — nmap and friends touch customer infrastructure, are marked
#     `external_binary`, and are FORCED onto the uid+nftables backend, which fails closed without
#     `nft`. That plane needs a privileged host; this one does not.
#
# Keeping them apart is what lets the sellable half ship without waiting on a hosting decision, and
# it also means the image that handles untrusted customer artifacts carries no network scanner at
# all — a smaller blast radius on the plane most likely to meet hostile input.
#
# Every tool here is cleared in docs/TOOL_LICENSES.md and enforced by tools/check_tool_licenses.py.
# Nothing AGPL, nothing requiring a commercial OEM licence.
#
# Download URLs arrive as build args rather than being written here. The first attempt hard-coded
# version numbers and asset filenames from memory and 404'd on the very first tool, so the workflow
# now resolves each project's actual release asset and passes the exact URL in. The resolved
# versions are recorded as image labels, so the artifact stays reproducible by digest and the build
# log states precisely what went in.

FROM debian:bookworm-slim AS tools

ARG TRIVY_URL
ARG GITLEAKS_URL
ARG OSV_SCANNER_URL
ARG SYFT_URL
ARG GRYPE_URL

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates tar \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /out

# Each URL is required. An unset arg would otherwise download nothing and leave the stage "successful"
# with a missing binary — the failure that reaches production as an engine quietly finding nothing.
RUN set -eu; \
    for pair in "TRIVY_URL=${TRIVY_URL}" "GITLEAKS_URL=${GITLEAKS_URL}" \
                "OSV_SCANNER_URL=${OSV_SCANNER_URL}" "SYFT_URL=${SYFT_URL}" \
                "GRYPE_URL=${GRYPE_URL}"; do \
      name="${pair%%=*}"; value="${pair#*=}"; \
      [ -n "$value" ] || { echo "build arg $name is empty"; exit 1; }; \
    done

# Tarball-distributed tools. Extracting only the named binary keeps licences, docs and stray files
# out of the runtime image.
RUN set -eu; \
    curl -fsSL "${TRIVY_URL}"    -o trivy.tgz    && tar -xzf trivy.tgz    trivy    && rm trivy.tgz; \
    curl -fsSL "${GITLEAKS_URL}" -o gitleaks.tgz && tar -xzf gitleaks.tgz gitleaks && rm gitleaks.tgz; \
    curl -fsSL "${SYFT_URL}"     -o syft.tgz     && tar -xzf syft.tgz     syft     && rm syft.tgz; \
    curl -fsSL "${GRYPE_URL}"    -o grype.tgz    && tar -xzf grype.tgz    grype    && rm grype.tgz

# osv-scanner ships a bare binary rather than an archive.
RUN set -eu; \
    curl -fsSL "${OSV_SCANNER_URL}" -o osv-scanner && chmod +x osv-scanner

RUN chmod +x trivy gitleaks syft grype osv-scanner \
    && ./trivy --version && ./gitleaks version && ./syft version \
    && ./grype version && ./osv-scanner --version


FROM python:3.12-slim

ARG TRIVY_VERSION=unset
ARG GITLEAKS_VERSION=unset
ARG OSV_SCANNER_VERSION=unset
ARG SYFT_VERSION=unset
ARG GRYPE_VERSION=unset
ARG SEMGREP_VERSION=1.101.0
ARG CHECKOV_VERSION=3.2.334

# The versions actually installed, readable from the image itself. A scanner that silently changes
# version changes its findings, and "which build produced this report" must be answerable later.
LABEL org.opencontainers.image.title="guardian-scanner" \
      guardian.tools.trivy="${TRIVY_VERSION}" \
      guardian.tools.gitleaks="${GITLEAKS_VERSION}" \
      guardian.tools.osv-scanner="${OSV_SCANNER_VERSION}" \
      guardian.tools.syft="${SYFT_VERSION}" \
      guardian.tools.grype="${GRYPE_VERSION}" \
      guardian.tools.semgrep="${SEMGREP_VERSION}" \
      guardian.tools.checkov="${CHECKOV_VERSION}"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# git: repository assets are cloned WITH history, because a secret deleted in a later commit is
# still readable and the working tree alone shows nothing (WP-D5).
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=tools /out/trivy /out/gitleaks /out/osv-scanner /out/syft /out/grype /usr/local/bin/

# Semgrep (LGPL-2.1, invoked as a separate process) and Checkov (Apache-2.0) install as Python
# packages. Both are already wrapped by existing engines; the wrappers no-op when absent, which is
# exactly why the deployed image never produced their findings before.
RUN pip install --no-cache-dir "semgrep==${SEMGREP_VERSION}" "checkov==${CHECKOV_VERSION}"

WORKDIR /app

COPY pyproject.toml README.md alembic.ini ./
COPY packages ./packages
COPY services ./services
COPY workers ./workers

RUN pip install --upgrade pip "setuptools>=78.1.1" && pip install -e . \
    && vendor="$(python -c 'import os, pip._vendor as v; print(os.path.dirname(v.__file__))')" \
    && rm -f "$vendor/bom.cdx.json" "$vendor/vendor.txt"

# Unprivileged. This plane is deliberately incapable of the kernel egress control the network plane
# needs — it has no business having it, and not having it is a property worth preserving.
RUN useradd --create-home --uid 10001 guardian && chown -R guardian:guardian /app
USER guardian

# Health: a broken image fails at start rather than at scan time by silently producing no findings —
# the failure mode that looks exactly like "you are secure".
HEALTHCHECK --interval=60s --timeout=20s --start-period=15s --retries=3 \
    CMD python -c "from guardian_scanner.registry import health_report; import sys; sys.exit(0 if health_report()['ok'] else 1)"

CMD ["celery", "-A", "guardian_scanner.celery_app.celery_app", "worker", \
     "--queues", "default", "--concurrency", "1", "--loglevel", "INFO"]
