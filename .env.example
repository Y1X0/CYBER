# ── Security Guardian Platform — example environment (non-secret defaults) ──
# Copy to .env and adjust. NEVER commit a real .env. See docs/architecture/06-security-model.md.

# Core
GUARDIAN_ENV=local
GUARDIAN_LOG_LEVEL=INFO

# Database (Postgres). P1-C: outside local/dev the DSN MUST enforce TLS — append
# ?sslmode=require (or verify-ca / verify-full, recommended). The connection carries encrypted
# credentials, PII, and the evidence chain; production refuses a non-TLS sslmode at startup.
GUARDIAN_DATABASE_URL=postgresql+psycopg://guardian:guardian@db:5432/guardian

# Queue / cache (Redis). P1-δ: outside local/dev the URL MUST carry AUTH credentials
# (redis[s]://:PASSWORD@host) and use TLS (rediss://) — the broker, result backend, and replay-nonce
# store must be authenticated so a compromised execution-plane worker cannot tamper the queue.
# Production sets GUARDIAN_REDIS_PASSWORD to a strong value; config refuses an unauthenticated URL.
GUARDIAN_REDIS_PASSWORD=dev-redis-pass
GUARDIAN_REDIS_URL=redis://:dev-redis-pass@redis:6379/0

# Auth — REPLACE in any real deployment. Generate: openssl rand -hex 32
GUARDIAN_JWT_SECRET=change-me-dev-only-do-not-use-in-production
GUARDIAN_JWT_ALGORITHM=HS256
GUARDIAN_ACCESS_TOKEN_TTL_MINUTES=60

# Cryptographic keys — REPLACE in any real deployment. Generate each: openssl rand -hex 32.
# P1-A key separation (enforced at startup outside local/dev):
#   * ENCRYPTION_KEY is the credential KMS master (decrypts stored tenant secrets). It lives ONLY on
#     the trusted DB-bound planes (API, default worker) — NEVER on the tool/recon execution planes.
#   * BROKER_SEAL_KEY seals sensitive job/result payloads on Redis (P1-4). It is a SEPARATE key, must
#     DIFFER from ENCRYPTION_KEY, and is the only crypto key the tool execution plane holds.
# The tool/recon execution planes must carry NEITHER the JWT secret NOR the ENCRYPTION_KEY.
GUARDIAN_ENCRYPTION_KEY=dev-only-encryption-key-change-me
GUARDIAN_BROKER_SEAL_KEY=dev-only-broker-seal-key-change-me

# Bootstrap tenant/admin created on first `make seed` (dev convenience only)
GUARDIAN_BOOTSTRAP_TENANT=Acme Security
GUARDIAN_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
GUARDIAN_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# CORS (comma-separated origins for the dashboard)
GUARDIAN_CORS_ORIGINS=http://localhost:5173

# AI analyst (Phase 3 — not used in Phase 1). Left blank on purpose.
GUARDIAN_ANTHROPIC_API_KEY=
